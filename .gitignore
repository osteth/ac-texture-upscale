# Build output
bin/
obj/
*.pdb

# Game data and anything derived from it -- never commit
*.dat
*.png
*.webp
*.bmp
*.jpg
*.idx
*.pal
*.bin
*.tsv
*.exe
work/
datsets/
dats/

# Local secrets / machine files
*.txt
!requirements.txt
!release/*.txt
!release/retail/*.txt
__pycache__/
.vs/
*.user

# Replacement art packed into the dats (see art/README.md)
!art/*.jpg

# Comparison site images (screenshots and sample crops for docs/index.html)
!docs/img/*.webp
